<% layout("/layouts/boilerplate") %>
<script>
  const mapToken = "<%= mapToken %>";
  const coordinates = <%- JSON.stringify(listing.geometry.coordinates) %>;
  const listingData = <%- JSON.stringify(listing) %>;
</script>

<style>
  .show-container {
    background-color: rgba(255, 255, 255, 0.65) !important;
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid rgba(255, 255, 255, 0.3) !important;
    border-radius: 24px;
    padding: 2.5rem;
    box-shadow: 0 15px 35px rgba(0, 0, 0, 0.05);
    margin-top: 1.5rem;
    margin-bottom: 4rem;
  }
  
  [data-bs-theme='dark'] .show-container {
    background-color: rgba(15, 23, 42, 0.65) !important;
    border: 1px solid rgba(255, 255, 255, 0.08) !important;
    box-shadow: 0 15px 35px rgba(0, 0, 0, 0.25);
  }

  .photo-grid-img {
    transition: filter 0.2s ease;
    cursor: pointer;
  }
  
  .photo-grid-container:hover .photo-grid-img:not(:hover) {
    filter: brightness(0.85);
  }
  
  .btn-show-all:hover {
    background-color: #f8f9fa !important;
    transform: scale(1.02);
  }
  
  .top-bar-btn {
    color: var(--bs-body-color) !important;
  }
  
  [data-bs-theme='dark'] .btn-show-all { 
    background-color: #212529 !important; 
    color: #f8f9fa !important; 
    border-color: rgba(255, 255, 255, 0.2) !important; 
  }
  
  .show-card-text {
    color: var(--bs-body-color) !important;
  }
  
  .show-card-muted {
    color: var(--bs-secondary-color) !important;
  }
</style>

<div class="row mt-3">
  <div class="col-12 col-md-10 offset-md-1 col-lg-8 offset-lg-2 px-2 px-md-3">
    <div class="show-container">
      
      <!-- Top Bar: Title & Actions -->
      <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4 gap-3">
        <h3 class="m-0 show-card-text" style="font-weight: 600; font-size: 1.7rem; word-break: break-word;"><%= listing.title %></h3>
        <div class="d-flex gap-3 flex-shrink-0">
          <button id="share-listing-btn" class="top-bar-btn btn btn-sm fw-semibold border-0 bg-transparent text-decoration-underline d-flex align-items-center" style="font-size: 0.95rem;">
            <i class="fa-solid fa-arrow-up-from-bracket me-2 pt-1"></i>Share
          </button>
          <button id="save-listing-btn" class="top-bar-btn btn btn-sm fw-semibold border-0 bg-transparent text-decoration-underline d-flex align-items-center" style="font-size: 0.95rem;">
            <i id="save-heart-icon" class="fa-regular fa-heart me-2 pt-1"></i><span id="save-text">Save</span>
          </button>
        </div>
      </div>

      <!-- Images Grid (Desktop) -->
      <% if(listing.images && listing.images.length >= 5) { %>
        <div class="photo-grid-container d-none d-md-block position-relative mb-4" style="border-radius: 12px; overflow: hidden; height: 50vh;">
          <div class="row g-2 h-100 w-100 m-0">
            <div class="col-md-6 h-100 p-0 pe-1">
              <img src="<%= listing.images[0].url.replace('/upload', '/upload/w_1000,q_auto,f_auto') %>" class="w-100 h-100 photo-grid-img" style="object-fit:cover;" alt="Main Image" data-bs-toggle="modal" data-bs-target="#allPhotosModal">
            </div>
            <div class="col-md-6 h-100 p-0 ps-1 d-flex flex-column gap-2">
              <div class="row g-2 h-50 m-0">
                <div class="col-6 h-100 p-0 pe-1 pb-1">
                  <img src="<%= listing.images[1].url.replace('/upload', '/upload/w_400,q_auto,f_auto') %>" class="w-100 h-100 photo-grid-img" style="object-fit:cover;" alt="Image 2" data-bs-toggle="modal" data-bs-target="#allPhotosModal">
                </div>
                <div class="col-6 h-100 p-0 ps-1 pb-1">
                  <img src="<%= listing.images[2].url.replace('/upload', '/upload/w_400,q_auto,f_auto') %>" class="w-100 h-100 photo-grid-img" style="object-fit:cover;" alt="Image 3" data-bs-toggle="modal" data-bs-target="#allPhotosModal">
                </div>
              </div>
              <div class="row g-2 h-50 m-0">
                <div class="col-6 h-100 p-0 pe-1 pt-1">
                  <img src="<%= listing.images[3].url.replace('/upload', '/upload/w_400,q_auto,f_auto') %>" class="w-100 h-100 photo-grid-img" style="object-fit:cover;" alt="Image 4" data-bs-toggle="modal" data-bs-target="#allPhotosModal">
                </div>
                <div class="col-6 h-100 p-0 ps-1 pt-1 position-relative">
                  <img src="<%= listing.images[4].url.replace('/upload', '/upload/w_400,q_auto,f_auto') %>" class="w-100 h-100 photo-grid-img" style="object-fit:cover;" alt="Image 5" data-bs-toggle="modal" data-bs-target="#allPhotosModal">
                  <button class="btn btn-light position-absolute border border-dark rounded-3 px-3 py-1 bg-white text-black btn-show-all shadow-sm" data-bs-toggle="modal" data-bs-target="#allPhotosModal" style="bottom: 16px; right: 16px; font-weight: 600; font-family: 'plus-jakarta-sans', sans-serif;">
                    <i class="fa-solid fa-braille me-2"></i>Show all photos
                  </button>
                </div>
              </div>
            </div>
          </div>
        </div>
      <% } %>

      <!-- Images Carousel (Mobile/Fallback) -->
      <% if(listing.images && listing.images.length > 0) { %>
        <div id="listingCarousel" class="carousel slide mb-4 <%= listing.images.length >= 5 ? 'd-md-none' : '' %>" data-bs-ride="false" data-bs-interval="false" style="border-radius: 12px; overflow: hidden;">
          <div class="carousel-indicators">
            <% listing.images.forEach((img, i) => { %>
              <button type="button" data-bs-target="#listingCarousel" data-bs-slide-to="<%= i %>" class="<%= i === 0 ? 'active' : '' %>" aria-current="true" aria-label="Slide <%= i+1 %>"></button>
            <% }) %>
          </div>
          <div class="carousel-inner" style="background: #fff; height: <%= listing.images.length >= 5 ? '35vh' : '50vh' %>;">
            <% listing.images.forEach((img, i) => { %>
              <div class="carousel-item <%= i === 0 ? 'active' : '' %> h-100" style="background: #fff; text-align: center;">
                <img src="<%= img.url.replace('/upload', '/upload/w_1000,q_auto,f_auto') %>" class="d-block w-100 h-100" alt="listing image" style="object-fit:cover;" data-bs-toggle="modal" data-bs-target="#allPhotosModal">
              </div>
            <% }) %>
          </div>
          <% if(listing.images.length > 1) { %>
            <button class="carousel-control-prev" type="button" data-bs-target="#listingCarousel" data-bs-slide="prev">
              <span class="carousel-control-prev-icon" aria-hidden="true" style="filter: drop-shadow(0px 0px 4px rgba(0,0,0,0.5));"></span>
              <span class="visually-hidden">Previous</span>
            </button>
            <button class="carousel-control-next" type="button" data-bs-target="#listingCarousel" data-bs-slide="next">
              <span class="carousel-control-next-icon" aria-hidden="true" style="filter: drop-shadow(0px 0px 4px rgba(0,0,0,0.5));"></span>
              <span class="visually-hidden">Next</span>
            </button>
          <% } %>
        </div>
      <% } else if (!listing.images || listing.images.length === 0) { %>
        <div class="mb-4" style="border-radius: 12px; overflow: hidden; height: 50vh;">
          <img src="<%= typeof listing.image === 'object' ? listing.image.url : listing.image %>" class="w-100 h-100" style="object-fit:cover;" alt="listing_image" />
        </div>
      <% } %>

      <!-- Listing Information Details -->
      <div class="mt-4">
        <p class="show-card-text mb-3" style="font-size: 1.15rem; font-weight: 500;">Hosted by <%= listing.owner ? listing.owner.username : 'IntelliJourney Developer' %></p>
        <hr class="my-3" style="border-color: rgba(0,0,0,0.1);">
        <p class="show-card-text my-3" style="font-size: 1.05rem; line-height: 1.7; font-weight: 400;"><%= listing.description %></p>
        <hr class="my-3" style="border-color: rgba(0,0,0,0.1);">
        <p class="show-card-text my-3" style="font-size: 1.1rem;"> 
           <span style="font-weight: 700; font-size: 1.45rem; color: var(--bs-body-color);">&#8377; <%= listing.price ? listing.price.toLocaleString("en-IN") : 'N/A' %></span> <span class="show-card-muted">/ night</span> 
        </p>
        <hr class="my-3" style="border-color: rgba(0,0,0,0.1);">
        <div class="my-3">
           <p class="show-card-text mb-1" style="font-weight: 500;"><i class="fa-solid fa-location-dot text-danger me-2"></i> <%= listing.location %></p>
           <p class="show-card-muted" style="font-size: 0.95rem;"><i class="fa-solid fa-globe me-2"></i> <%= listing.country %></p>
        </div>
      </div>

      <!-- Action Buttons (Edit / Delete) -->
      <% if( currUser && listing.owner && currUser._id.equals(listing.owner._id)) { %>
        <div class="d-flex gap-2 my-4">
          <a href="/listings/<%= listing._id %>/edit" class="btn btn-danger edit-btn px-4 py-2 fw-semibold rounded-3 shadow-sm" style="background-color: #fe424d !important;">
            Edit Details
          </a>
          <form method="POST" action="/listings/<%=listing._id%>?_method=DELETE">
            <button class="btn btn-dark px-4 py-2 fw-semibold rounded-3 shadow-sm">Delete Listing</button>
          </form>
        </div>
      <% } %>

      <!-- Reviews Section -->
      <div class="mt-4">
        <% if(currUser) { %>
          <hr class="my-4" style="border-color: rgba(0,0,0,0.1);">
          <h4 class="fw-bold show-card-text">Leave a Review</h4>
          <form action="/listings/<%= listing._id %>/reviews" method="post" novalidate class="needs-validation">
            <div class="mb-3 mt-3">
              <label for="rating" class="form-label show-card-text fw-medium">Rating</label>
              <fieldset class="starability-slot">
                <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
                <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                <label for="first-rate1" title="Terrible">1 star</label>
                <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                <label for="first-rate2" title="Not good">2 stars</label>
                <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                <label for="first-rate3" title="Average">3 stars</label>
                <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                <label for="first-rate4" title="Very good">4 stars</label>
                <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                <label for="first-rate5" title="Amazing">5 stars</label>
              </fieldset>
            </div>

            <div class="mb-3">
              <label for="comment" class="form-label show-card-text fw-medium">Comments</label>
              <textarea name="review[comment]" id="comment" cols="30" rows="4" class="form-control rounded-3" required placeholder="Share your experience here..."></textarea>
              <div class="invalid-feedback">Please add some comments for the review.</div>
            </div>
            
            <button class="btn btn-outline-danger rounded-3 px-4 py-2 fw-semibold">Submit Review</button>
          </form>
        <% } %>

        <% if (listing.reviews.length > 0) { %>
          <hr class="my-4" style="border-color: rgba(0,0,0,0.1);">
          <p class="mb-3 show-card-text"><b>All Reviews</b></p>
          <div class="row g-3">
            <% for(review of listing.reviews){ %>
              <div class="col-12 col-md-6 mb-3">
                <div class="card h-100 rounded-3 border" style="background: rgba(255, 255, 255, 0.4); border-color: rgba(255,255,255,0.2) !important;">
                  <div class="card-body p-3">
                    <h5 class="card-title show-card-text fw-semibold mb-1" style="font-size: 1rem;">@<%= review.author ? review.author.username : 'Anonymous' %></h5>
                    <p class="starability-result card-text mb-2" data-rating="<%= review.rating %>"></p>
                    <p class="card-text show-card-text mb-3" style="font-size: 0.95rem;"><%= review.comment %></p>
                    <% if(currUser && review.author && currUser._id.equals(review.author._id)) { %>
                      <form method="POST" action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE">
                        <button class="btn btn-sm btn-outline-danger rounded-3 px-3">Delete</button>
                      </form>
                    <% } %>
                  </div>
                </div>
              </div>
            <% } %>
          </div>
        <% } %>
      </div>

      <!-- Map View Location -->
      <div class="mt-4">
        <hr class="my-4" style="border-color: rgba(0,0,0,0.1);">
        <h4 class="fw-bold show-card-text mb-3">Where you'll be</h4>
        <div id="map" class="rounded-4 w-100 shadow-sm" style="height: 350px;"></div>
      </div>

    </div>
  </div>
</div>

<script>
  let mapTokenLocal = "<%= process.env.Map_TOKEN %>";
  mapboxgl.accessToken = mapTokenLocal;

  const mapLocal = new mapboxgl.Map({
    container: "map",
    style: "mapbox://styles/mapbox/streets-v12",
    center: coordinates && coordinates.length === 2 ? coordinates : [75.7873, 26.9124],
    zoom: 9
  });
  
  if (coordinates && coordinates.length === 2) {
    new mapboxgl.Marker({ color: "#fe424d" })
      .setLngLat(coordinates)
      .addTo(mapLocal);
  }
</script>

<script src="/js/map.js"></script>

<!-- All Photos Modal -->
<div class="modal fade" id="allPhotosModal" tabindex="-1" aria-labelledby="allPhotosModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-fullscreen">
    <div class="modal-content text-bg-dark">
      <div class="modal-header border-0 pb-0">
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body d-flex justify-content-center align-items-center">
        <% if(listing.images && listing.images.length > 0) { %>
          <div id="modalCarousel" class="carousel slide" data-bs-ride="false" style="max-width: 900px; width: 100%;">
            <div class="carousel-inner text-center">
              <% listing.images.forEach((img, i) => { %>
                <div class="carousel-item <%= i === 0 ? 'active' : '' %>">
                  <img src="<%= img.url.replace('/upload', '/upload/w_1200,q_auto,f_auto') %>" class="img-fluid" style="max-height: 85vh; object-fit: contain;" alt="Listing image <%= i+1 %>">
                </div>
              <% }) %>
            </div>
            <% if(listing.images.length > 1) { %>
              <button class="carousel-control-prev" type="button" data-bs-target="#modalCarousel" data-bs-slide="prev">
                <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Previous</span>
              </button>
              <button class="carousel-control-next" type="button" data-bs-target="#modalCarousel" data-bs-slide="next">
                <span class="carousel-control-next-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Next</span>
              </button>
            <% } %>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</div>

<script>
  // Share Button functionality
  document.getElementById('share-listing-btn')?.addEventListener('click', async (e) => {
    e.preventDefault();
    if (navigator.share) {
      try {
        await navigator.share({
          title: '<%= listing.title %>',
          url: window.location.href
        });
      } catch (err) {
        console.error('Error sharing:', err);
      }
    } else {
      navigator.clipboard.writeText(window.location.href);
      const originalText = e.currentTarget.innerHTML;
      e.currentTarget.innerHTML = '<i class="fa-solid fa-check me-2 pt-1"></i>Copied';
      setTimeout(() => e.currentTarget.innerHTML = originalText, 2000);
    }
  });

  // Save Button Functionality
  const saveBtn = document.getElementById('save-listing-btn');
  const saveIcon = document.getElementById('save-heart-icon');
  const saveText = document.getElementById('save-text');
  
  if (saveBtn) {
    const listingId = '<%= listing._id %>';
    const savedListings = JSON.parse(localStorage.getItem('savedListings') || '[]');
    
    // Check initial state
    if (savedListings.includes(listingId)) {
      saveIcon.classList.remove('fa-regular');
      saveIcon.classList.add('fa-solid', 'text-danger');
      saveText.innerText = 'Saved';
    }

    saveBtn.addEventListener('click', (e) => {
      e.preventDefault();
      let currentSaved = JSON.parse(localStorage.getItem('savedListings') || '[]');
      
      if (currentSaved.includes(listingId)) {
        currentSaved = currentSaved.filter(id => id !== listingId);
        saveIcon.classList.add('fa-regular');
        saveIcon.classList.remove('fa-solid', 'text-danger');
        saveText.innerText = 'Save';
      } else {
        currentSaved.push(listingId);
        saveIcon.classList.remove('fa-regular');
        saveIcon.classList.add('fa-solid', 'text-danger');
        saveText.innerText = 'Saved';
      }
      localStorage.setItem('savedListings', JSON.stringify(currentSaved));
    });
  }
</script>