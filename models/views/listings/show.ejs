</div>

<script>
  // Share Button functionality
  document.getElementById('share-listing-btn')?.addEventListener('click', async (e) => {
    e.preventDefault();
    if (navigator.share) {
      try {
        await navigator.share({
          title: '<%= listing.title %>',
          url: window.location.href
        });
      } catch (err) {
        console.error('Error sharing:', err);
      }
    } else {
      navigator.clipboard.writeText(window.location.href);
      const originalText = e.currentTarget.innerHTML;
      e.currentTarget.innerHTML = '<i class="fa-solid fa-check me-2 pt-1"></i>Copied';
      setTimeout(() => e.currentTarget.innerHTML = originalText, 2000);
    }
  });

  // Save Button Functionality
  const saveBtn = document.getElementById('save-listing-btn');
  const saveIcon = document.getElementById('save-heart-icon');
  const saveText = document.getElementById('save-text');
  
  if (saveBtn) {
    const listingId = '<%= listing._id %>';
    const savedListings = JSON.parse(localStorage.getItem('savedListings') || '[]');
    
    // Check initial state
    if (savedListings.includes(listingId)) {
      saveIcon.classList.remove('fa-regular');
      saveIcon.classList.add('fa-solid', 'text-danger');
      saveText.innerText = 'Saved';
    }

    saveBtn.addEventListener('click', (e) => {
      e.preventDefault();
      let currentSaved = JSON.parse(localStorage.getItem('savedListings') || '[]');
      
      if (currentSaved.includes(listingId)) {
        // Unsave
        currentSaved = currentSaved.filter(id => id !== listingId);
        saveIcon.classList.add('fa-regular');
        saveIcon.classList.remove('fa-solid', 'text-danger');
        saveText.innerText = 'Save';
      } else {
        // Save
        currentSaved.push(listingId);
        saveIcon.classList.remove('fa-regular');
        saveIcon.classList.add('fa-solid', 'text-danger');
        saveText.innerText = 'Saved';
      }
      localStorage.setItem('savedListings', JSON.stringify(currentSaved));
    });
  }
</script>
