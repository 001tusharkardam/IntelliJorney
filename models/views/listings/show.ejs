<% layout("/layouts/boilerplate") %>
<script>
  const mapToken = "<%= mapToken %>";
  const coordinates = <%- JSON.stringify(listing.geometry.coordinates) %>;
  const listingData = <%- JSON.stringify(listing) %>;
</script>
<div class="row mt-3">
  <div class="col-12 col-md-10 offset-md-1 col-lg-8 offset-lg-2 px-4 px-md-3">
    <style>
      .photo-grid-img {
        transition: filter 0.2s ease;
        cursor: pointer;
      }
      .photo-grid-container:hover .photo-grid-img:not(:hover) {
        filter: brightness(0.85);
      }
      .btn-show-all:hover {
        background-color: #f8f9fa !important;
        transform: scale(1.02);
      }
      [data-bs-theme='dark'] .top-bar-btn { color: #f8f9fa !important; }
      [data-bs-theme='dark'] .btn-show-all { background-color: #212529 !important; color: #f8f9fa !important; border-color: #f8f9fa !important; }
    </style>

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4 gap-3">
      <h3 class="m-0" style="font-weight: 600; font-size: 1.7rem; word-break: break-word;"><%= listing.title %></h3>
      <div class="d-flex gap-3 flex-shrink-0">
        <button id="share-listing-btn" class="top-bar-btn btn btn-sm text-dark fw-semibold border-0 bg-transparent text-decoration-underline d-flex align-items-center" style="font-size: 0.95rem;">
          <i class="fa-solid fa-arrow-up-from-bracket me-2 pt-1"></i>Share
        </button>
        <button id="save-listing-btn" class="top-bar-btn btn btn-sm text-dark fw-semibold border-0 bg-transparent text-decoration-underline d-flex align-items-center" style="font-size: 0.95rem;">
          <i id="save-heart-icon" class="fa-regular fa-heart me-2 pt-1"></i><span id="save-text">Save</span>
        </button>
      </div>
    </div>

    <% if(listing.images && listing.images.length >= 5) { %>
      <!-- Desktop Grid -->
      <div class="photo-grid-container d-none d-md-block position-relative mb-4" style="border-radius: 12px; overflow: hidden; height: 60vh;">
        <div class="row g-2 h-100 w-100 m-0">
          <div class="col-md-6 h-100 p-0 pe-1">
            <img src="<%= listing.images[0].url.replace('/upload', '/upload/w_1000,q_auto,f_auto') %>" class="w-100 h-100 photo-grid-img" style="object-fit:cover;" alt="Main Image" data-bs-toggle="modal" data-bs-target="#allPhotosModal">
          </div>
          <div class="col-md-6 h-100 p-0 ps-1 d-flex flex-column gap-2">
            <div class="row g-2 h-50 m-0">
              <div class="col-6 h-100 p-0 pe-1 pb-1">
                <img src="<%= listing.images[1].url.replace('/upload', '/upload/w_400,q_auto,f_auto') %>" class="w-100 h-100 photo-grid-img" style="object-fit:cover;" alt="Image 2" data-bs-toggle="modal" data-bs-target="#allPhotosModal">
              </div>
              <div class="col-6 h-100 p-0 ps-1 pb-1">
                <img src="<%= listing.images[2].url.replace('/upload', '/upload/w_400,q_auto,f_auto') %>" class="w-100 h-100 photo-grid-img" style="object-fit:cover;" alt="Image 3" data-bs-toggle="modal" data-bs-target="#allPhotosModal">
              </div>
            </div>
            <div class="row g-2 h-50 m-0">
              <div class="col-6 h-100 p-0 pe-1 pt-1">
                <img src="<%= listing.images[3].url.replace('/upload', '/upload/w_400,q_auto,f_auto') %>" class="w-100 h-100 photo-grid-img" style="object-fit:cover;" alt="Image 4" data-bs-toggle="modal" data-bs-target="#allPhotosModal">
              </div>
              <div class="col-6 h-100 p-0 ps-1 pt-1 position-relative">
                <img src="<%= listing.images[4].url.replace('/upload', '/upload/w_400,q_auto,f_auto') %>" class="w-100 h-100 photo-grid-img" style="object-fit:cover;" alt="Image 5" data-bs-toggle="modal" data-bs-target="#allPhotosModal">
                <button class="btn btn-light position-absolute border border-dark rounded-3 px-3 py-1 bg-white text-black btn-show-all shadow-sm" data-bs-toggle="modal" data-bs-target="#allPhotosModal" style="bottom: 16px; right: 16px; font-weight: 600; font-family: 'plus-jakarta-sans', sans-serif;">
                  <i class="fa-solid fa-braille me-2"></i>Show all photos
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>
    <% } %>

    <% if(listing.images && listing.images.length > 0) { %>
      <!-- Mobile Carousel (or Desktop if < 5 images) -->
      <div id="listingCarousel" class="carousel slide mb-4 <%= listing.images.length >= 5 ? 'd-md-none' : '' %>" data-bs-ride="false" data-bs-interval="false" style="border-radius: 12px; overflow: hidden;">
        <div class="carousel-indicators">
          <% listing.images.forEach((img, i) => { %>
            <button type="button" data-bs-target="#listingCarousel" data-bs-slide-to="<%= i %>" class="<%= i === 0 ? 'active' : '' %>" aria-current="true" aria-label="Slide <%= i+1 %>"></button>
          <% }) %>
        </div>
        <div class="carousel-inner" style="background: #fff; height: <%= listing.images.length >= 5 ? '40vh' : '60vh' %>;">
          <% listing.images.forEach((img, i) => { %>
            <div class="carousel-item <%= i === 0 ? 'active' : '' %> h-100" style="background: #fff; text-align: center;">
              <img src="<%= img.url.replace('/upload', '/upload/w_1000,q_auto,f_auto') %>" class="d-block w-100 h-100" alt="listing image" style="object-fit:cover;" data-bs-toggle="modal" data-bs-target="#allPhotosModal">
            </div>
          <% }) %>
        </div>
        <% if(listing.images.length > 1) { %>
          <button class="carousel-control-prev" type="button" data-bs-target="#listingCarousel" data-bs-slide="prev">
            <span class="carousel-control-prev-icon" aria-hidden="true" style="filter: drop-shadow(0px 0px 4px rgba(0,0,0,0.5));"></span>
            <span class="visually-hidden">Previous</span>
          </button>
          <button class="carousel-control-next" type="button" data-bs-target="#listingCarousel" data-bs-slide="next">
            <span class="carousel-control-next-icon" aria-hidden="true" style="filter: drop-shadow(0px 0px 4px rgba(0,0,0,0.5));"></span>
            <span class="visually-hidden">Next</span>
          </button>
        <% } %>
      </div>
    <% } else if (!listing.images || listing.images.length === 0) { %>
      <div class="mb-4" style="border-radius: 12px; overflow: hidden; height: 60vh;">
        <img src="<%= typeof listing.image === 'object' ? listing.image.url : listing.image %>" class="w-100 h-100" style="object-fit:cover;" alt="listing_image" />
      </div>
    <% } %>

    <div class="card-body p-0 mt-3 listing-card border-0" style="background: transparent;">
