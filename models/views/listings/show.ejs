      <hr>
      <p class="card-text my-4" style="font-size: 1rem; line-height: 1.6;"> <%= listing.description %> </p>
      <hr>
      <p class="card-text my-4" style="font-size: 1.1rem;"> 
         <span style="font-weight: 600; font-size: 1.3rem;">&#8377; <%= listing.price ? listing.price.toLocaleString("en-IN") : 'N/A' %></span> / night 
      </p>
      <hr>
      <div class="my-4">
         <p class="card-text mb-1" style="font-weight: 500;"><i class="fa-solid fa-location-dot me-2"></i> <%= listing.location %></p>
         <p class="card-text" style="color: #717171;"><i class="fa-solid fa-globe me-2"></i> <%= listing.country %></p>
      </div>
    </div>
  </div>
    <br>
    <% if( currUser && listing.owner && currUser._id.equals(listing.owner._id)) { %>
